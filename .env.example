# Public web config (safe to ship to the browser). Real values come from Firebase console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to connect to local emulators in dev
VITE_USE_EMULATORS=false
# NEVER put service account keys / serviceAccountKey.json in this project's frontend or env.

# --- Local emulator mode (no real Firebase project needed) ---
# VITE_FIREBASE_API_KEY=demo
# VITE_FIREBASE_PROJECT_ID=demo-tokyo
# VITE_FIREBASE_APP_ID=demo
# VITE_USE_EMULATORS=true
